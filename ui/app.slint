import { Button, LineEdit, ListView, VerticalBox, HorizontalBox, ProgressIndicator } from "std-widgets.slint";
import { PickerWindow } from "picker.slint";

// Re-exported so the generated Rust module exposes it next to AppWindow.
export { PickerWindow }

export struct TreeRow {
    label: string,
    indent: int,
    path: string,
    bg: color,
    text-color: color,
}

export struct TextRow {
    text: string,
}

export struct ActionRow {
    label: string,
    action: string,
}

export component AppWindow inherits Window {
    title: "Dissonance";
    preferred-width: 900px;
    preferred-height: 600px;

    // Rust <-> UI state
    in-out property <string> source;
    in-out property <string> destination;

    in property <[TreeRow]> tree;
    in property <[TextRow]> info-lines;
    in property <[TextRow]> problems;
    in property <[ActionRow]> actions;

    // UI -> Rust
    callback source-accepted();
    callback destination-accepted();
    callback start-sync();
    callback start-index();
    callback row-clicked(string);
    callback action-clicked(string);

    // Main view
    VerticalBox {
        // Top panel: source / destination inputs + Sync / Index buttons
        VerticalLayout {
            spacing: 4px;
            LineEdit {
                placeholder-text: "Source...";
                text <=> root.source;
                accepted => { root.source-accepted(); }
            }
            LineEdit {
                placeholder-text: "Destination...";
                text <=> root.destination;
                accepted => { root.destination-accepted(); }
            }
            HorizontalLayout {
                spacing: 4px;
                Button {
                    text: "Sync";
                    clicked => { root.start-sync(); }
                }
                Button {
                    text: "Index";
                    clicked => { root.start-index(); }
                }
                Rectangle {}
            }
        }

        // Main panel: tree | info + problems | actions
        HorizontalBox {
            // File tree
            ListView {
                horizontal-stretch: 2;
                for row in root.tree: HorizontalLayout {
                    padding-left: row.indent * 16px;
                    Rectangle {
                        background: row.bg;
                        horizontal-stretch: 0;
                        HorizontalLayout {
                            padding: 2px;
                            TouchArea {
                                clicked => { root.row-clicked(row.path); }
                                Text {
                                    text: row.label;
                                    color: row.text-color;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Rectangle {}
                }
            }

            // Info + problems
            VerticalLayout {
                horizontal-stretch: 4;
                spacing: 8px;
                ListView {
                    vertical-stretch: 3;
                    for line in root.info-lines: Text {
                        text: line.text;
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for p in root.problems: Text {
                        text: p.text;
                    }
                }
            }

            // Actions
            ListView {
                horizontal-stretch: 1;
                for a in root.actions: HorizontalLayout {
                    Button {
                        text: a.label;
                        clicked => { root.action-clicked(a.action); }
                    }
                }
            }
        }
    }
}

// Standalone window shown while a sync runs. It does not close on its own;
// the user dismisses it with the Close button.
export component ProgressWindow inherits Window {
    title: "Syncing";
    preferred-width: 360px;
    preferred-height: 140px;

    in property <float> progress;
    in property <bool> done;

    callback close-window();

    VerticalBox {
        alignment: center;
        spacing: 12px;
        Text {
            text: root.done ? "Sync complete" : "Processing…";
            horizontal-alignment: center;
        }
        ProgressIndicator {
            progress: root.progress;
        }
        HorizontalLayout {
            alignment: center;
            Button {
                text: "Close";
                clicked => { root.close-window(); }
            }
        }
    }
}
