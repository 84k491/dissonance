import { Button, LineEdit, ListView, VerticalBox, HorizontalBox, ProgressIndicator } from "std-widgets.slint";

export struct TreeRow {
    label: string,
    indent: int,
    path: string,
    bg: color,
    text-color: color,
}

export struct TextRow {
    text: string,
}

export struct ActionRow {
    label: string,
    action: string,
}

export struct ArtistOption {
    label: string,
    index: int,
}

export struct AlbumOption {
    label: string,
    index: int,
}

export struct TrackOption {
    label: string,
    index: int,
}

export component AppWindow inherits Window {
    title: "Dissonance";
    preferred-width: 900px;
    preferred-height: 600px;

    // Rust <-> UI state
    in-out property <string> source;
    in-out property <string> destination;

    in property <[TreeRow]> tree;
    in property <[TextRow]> info-lines;
    in property <[TextRow]> problems;
    in property <[ActionRow]> actions;
    in property <image> cover;

    // UI -> Rust
    callback source-accepted();
    callback destination-accepted();
    callback start-sync();
    callback start-index();
    callback row-clicked(string);
    callback action-clicked(string);

    // Main view
    VerticalBox {
        // Top panel: source / destination inputs + Sync / Index buttons
        VerticalLayout {
            spacing: 4px;
            LineEdit {
                placeholder-text: "Source...";
                text <=> root.source;
                accepted => { root.source-accepted(); }
            }
            LineEdit {
                placeholder-text: "Destination...";
                text <=> root.destination;
                accepted => { root.destination-accepted(); }
            }
            HorizontalLayout {
                spacing: 4px;
                Button {
                    text: "Sync";
                    clicked => { root.start-sync(); }
                }
                Button {
                    text: "Index";
                    clicked => { root.start-index(); }
                }
                Rectangle {}
            }
        }

        // Main panel: tree | info + problems | actions
        HorizontalBox {
            // File tree
            ListView {
                horizontal-stretch: 2;
                for row in root.tree: HorizontalLayout {
                    padding-left: row.indent * 16px;
                    Rectangle {
                        background: row.bg;
                        horizontal-stretch: 0;
                        HorizontalLayout {
                            padding: 2px;
                            TouchArea {
                                clicked => { root.row-clicked(row.path); }
                                Text {
                                    text: row.label;
                                    color: row.text-color;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Rectangle {}
                }
            }

            // Info + problems
            VerticalLayout {
                horizontal-stretch: 4;
                spacing: 8px;
                ListView {
                    vertical-stretch: 3;
                    for line in root.info-lines: Text {
                        text: line.text;
                    }
                }
                Image {
                    source: root.cover;
                    height: root.cover.height > 0 ? 200px : 0px;
                    min-width: 0px;
                    preferred-width: 0px;
                    image-fit: contain;
                }
                ListView {
                    vertical-stretch: 1;
                    for p in root.problems: Text {
                        text: p.text;
                    }
                }
            }

            // Actions
            ListView {
                horizontal-stretch: 1;
                for a in root.actions: HorizontalLayout {
                    Button {
                        text: a.label;
                        clicked => { root.action-clicked(a.action); }
                    }
                }
            }
        }
    }
}

// Standalone window shown while a sync runs. It does not close on its own;
// the user dismisses it with the Close button.
export component ProgressWindow inherits Window {
    title: "Syncing";
    preferred-width: 360px;
    preferred-height: 140px;

    in property <float> progress;
    in property <bool> done;

    callback close-window();

    VerticalBox {
        alignment: center;
        spacing: 12px;
        Text {
            text: root.done ? "Sync complete" : "Processing…";
            horizontal-alignment: center;
        }
        ProgressIndicator {
            progress: root.progress;
        }
        HorizontalLayout {
            alignment: center;
            Button {
                text: "Close";
                clicked => { root.close-window(); }
            }
        }
    }
}

// Standalone window shown while a remote artist mapping is requested. The
// worker thread that opened it waits until one of these buttons is pressed.
export component ArtistSelectWindow inherits Window {
    title: "Remote artist";
    preferred-width: 460px;
    preferred-height: 420px;

    in property <string> local-name;
    in property <[ArtistOption]> options;

    callback chosen(int);
    callback no-suitable();
    callback cancel();

    VerticalBox {
        Text {
            text: "Local artist: " + root.local-name;
        }
        ListView {
            vertical-stretch: 1;
            for o in root.options: HorizontalLayout {
                Button {
                    text: o.label;
                    clicked => { root.chosen(o.index); }
                }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            Button {
                text: "No suitable";
                clicked => { root.no-suitable(); }
            }
            Button {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
        }
    }
}

